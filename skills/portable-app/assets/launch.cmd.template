@echo off
chcp 65001 >nul
setlocal

set "APP_ID=<AppId>Portable"
set "APP_ROOT=%~dp0"
set "DATA=%APP_ROOT%Data"
set "PROGRAM=%APP_ROOT%App\<AppId>\<AppId>.exe"
set "LOCK=%DATA%\Session.lock"

for %%D in (Temp Cache Logs AppDataRoaming AppDataLocal) do (
    if not exist "%DATA%\%%D" mkdir "%DATA%\%%D"
    if errorlevel 1 goto :noWrite
)

set "TEMP=%DATA%\Temp"
set "TMP=%DATA%\Temp"

rem Stage 2: only for apps that read these variables
rem set "APPDATA=%DATA%\AppDataRoaming"
rem set "LOCALAPPDATA=%DATA%\AppDataLocal"

rem Tool caches: only if the app runs these tools
rem set "NPM_CONFIG_CACHE=%DATA%\Cache\npm"
rem set "UV_CACHE_DIR=%DATA%\Cache\uv"
rem set "PIP_CACHE_DIR=%DATA%\Cache\pip"
rem set "CUDA_CACHE_PATH=%DATA%\Cache\CUDA"
rem set "DOTNET_BUNDLE_EXTRACT_BASE_DIR=%DATA%\Temp"

rem Stage 3: one line per folder, narrowest path possible
set "LINK1=%APPDATA%\<Vendor>\<AppId>"
set "LINK1_DATA=%DATA%\AppDataRoaming\<AppId>"

if exist "%LOCK%" call :restore
echo %DATE% %TIME%>"%LOCK%"
call :prepare "%LINK1%" "%LINK1_DATA%"

"%PROGRAM%" <flags, e.g. --user-data-dir="%DATA%\Profile">
call :waitChildren

call :restore
del "%LOCK%" >nul 2>&1
rd /s /q "%DATA%\Temp" >nul 2>&1
exit /b 0

:prepare
if not exist "%~2" mkdir "%~2"
if exist "%~1" ren "%~1" "%~nx1-BackupBy%APP_ID%"
if not exist "%~dp1" mkdir "%~dp1"
mklink /J "%~1" "%~2" >nul
exit /b

:restore
call :unlink "%LINK1%"
exit /b

:unlink
dir /AL /B "%~dp1" 2>nul | findstr /X /I /C:"%~nx1" >nul && rmdir "%~1"
if exist "%~1-BackupBy%APP_ID%" ren "%~1-BackupBy%APP_ID%" "%~nx1"
rmdir "%~dp1" >nul 2>&1
exit /b

:waitChildren
tasklist /FI "IMAGENAME eq <AppId>.exe" 2>nul | find /I "<AppId>.exe" >nul || exit /b
timeout /t 1 /nobreak >nul
goto :waitChildren

:noWrite
echo No write access next to the program: %APP_ROOT%
pause
exit /b 1
